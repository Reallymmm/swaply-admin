# Скопируй этот файл в .env и впиши свой пароль от PostgreSQL
# формат: postgresql+psycopg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5432/ИМЯ_БАЗЫ
DATABASE_URL=postgresql+psycopg://postgres:ТВОЙ_ПАРОЛЬ@localhost:5432/swaply

# Почта для отправки кодов подтверждения при регистрации в приложении.
# Пока SMTP_HOST пустой, письма не уходят, а код печатается в окне сервера (удобно для проверки).
#
# Gmail:  SMTP_HOST=smtp.gmail.com   SMTP_PORT=465
#         пароль - не от аккаунта, а "пароль приложения" (Аккаунт Google -> Безопасность -> Пароли приложений)
# Яндекс: SMTP_HOST=smtp.yandex.ru   SMTP_PORT=465
# Mail.ru: SMTP_HOST=smtp.mail.ru    SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# от чьего имени идут письма (если пусто, берётся SMTP_USER)
SMTP_FROM=

# Почта для кодов подтверждения (Brevo). Без BREVO_API_KEY код просто печатается в окне сервера.
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=адрес, подтверждённый в Brevo
BREVO_SENDER_NAME=Swaply
